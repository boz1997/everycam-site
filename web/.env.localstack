# Local stack only (EC `npm run local` → EC/local/webDev.mjs → vite --mode localstack).
# Vite reads this file for that mode and no other; vite.config.ts refuses to BUILD in it.
# No secrets: the ports of the demo-sharecam emulators and the mock Paddle on this Mac.
# Keep in step with EC/firebase.local.json and EC/local/config.mjs (stack.mjs checks them).
VITE_LOCAL_STACK=1
VITE_LOCAL_AUTH_PORT=9380
VITE_LOCAL_FIRESTORE_PORT=8380
VITE_LOCAL_FUNCTIONS_PORT=5380
VITE_LOCAL_STORAGE_PORT=9480
VITE_LOCAL_MOCK_PORT=8797
VITE_LOCAL_SITE_ORIGIN=http://127.0.0.1:8796
VITE_LOCAL_WEB_ORIGIN=http://127.0.0.1:5187
